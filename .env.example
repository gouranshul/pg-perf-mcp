# Copy to .env and replace every placeholder. .env is git-ignored; never commit it.

# Bootstrap superuser of the demo database (used only by the init scripts and demo/*.sh).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-superuser-password
POSTGRES_DB=shop

# Password of the mcp_readonly role that pg-perf-mcp connects as.
MCP_DB_PASSWORD=replace-with-a-readonly-role-password

# Bearer token MCP clients must send: Authorization: Bearer <MCP_API_KEY>
# Generate one with: openssl rand -hex 32
MCP_API_KEY=replace-with-a-long-random-api-key

# Optional OpenTelemetry tracing (off by default).
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Host ports.
DB_PORT=5432
APP_PORT=8080
